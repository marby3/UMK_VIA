# UMK_VIA - core firmware build entry.
#
#   make KEYBOARD=<name> [KEYMAP=<name>] main.bin   build only
#   make KEYBOARD=<name> [KEYMAP=<name>]            build, then try cv_flash
#   make KEYBOARD=<name> [KEYMAP=<name>] clean
#
# Every generated file lands in build/ at the repo root; nothing is written
# into firmware/ or lib/.
#
# cv_flash needs a WCH-LinkE. The Web Flasher path does not - it takes the
# build/main.bin produced here.

ifndef KEYBOARD
$(error KEYBOARD is not set. Use: make KEYBOARD=<name> [KEYMAP=<name>])
endif

KEYMAP ?= default
PYTHON ?= python

BUILD_DIR  := ../build
TARGET     := $(BUILD_DIR)/main
TARGET_MCU := CH32V003
CH32FUN    := lib/ch32v003fun/ch32fun

KEYBOARD_DIR := ../keyboards/$(KEYBOARD)
KEYMAP_C     := $(KEYBOARD_DIR)/keymaps/$(KEYMAP)/keymap.c

ifeq ($(wildcard $(KEYBOARD_DIR)/config.h),)
$(error No such keyboard: $(KEYBOARD_DIR)/config.h not found)
endif

# Vendored USB stack. Listed first so it is always linked in.
ADDITIONAL_C_FILES += lib/rv003usb/rv003usb/rv003usb.S
ADDITIONAL_C_FILES += lib/rv003usb/rv003usb/rv003usb.c

# Hardware layer.
ADDITIONAL_C_FILES += drivers/usb_config.c
ADDITIONAL_C_FILES += drivers/matrix.c
ADDITIONAL_C_FILES += drivers/split.c
ADDITIONAL_C_FILES += drivers/rgb_led.c

# Keyboard logic. core/main.c is $(TARGET).c below, so it is not listed here.
ADDITIONAL_C_FILES += core/keymap.c
ADDITIONAL_C_FILES += core/flash_store.c
ADDITIONAL_C_FILES += core/via.c

# The keymap overrides the weak default_keymap in core/keymap.c. A keyboard
# without the requested keymap directory still builds - it just does nothing.
ifneq ($(wildcard $(KEYMAP_C)),)
ADDITIONAL_C_FILES += $(KEYMAP_C)
else
$(warning $(KEYMAP_C) not found - building with the empty default keymap)
endif

EXTRA_CFLAGS += -Icore
EXTRA_CFLAGS += -Idrivers
EXTRA_CFLAGS += -Ilib/rv003usb/rv003usb
EXTRA_CFLAGS += -I$(KEYBOARD_DIR)

TARGET_EXT := c
MAIN_C     := core/main.c

# Keep the generated linker script out of the vendored tree. LINKER_SCRIPT is
# ?= inside ch32fun.mk, so presetting it here wins.
LINKER_SCRIPT := $(BUILD_DIR)/ch32v003.ld

# minichlink auto-detects the programmer, including the rv003usb USB
# bootloader (b003boot, VID 0x1209 / PID 0xB003). MINICHLINK_EXTRA lets a
# caller pin it down, e.g. MINICHLINK_EXTRA="-C b003boot".
MINICHLINK_EXTRA ?=
FLASH_COMMAND = $(MINICHLINK)/minichlink $(MINICHLINK_EXTRA) -w $< $(WRITE_SECTION) -b

# ch32fun.mk tracks only .c files, and switching -kb/-km swaps one existing
# source for another without making the output look stale. Everything that can
# change the image therefore has to be named here, or the build quietly hands
# back the previous binary. It is a single gcc invocation, so a full rebuild on
# any header change costs nothing worth optimising.
EXTRA_ELF_DEPENDENCIES := $(BUILD_DIR)/config.sig
EXTRA_ELF_DEPENDENCIES += $(wildcard $(KEYBOARD_DIR)/config.h)
EXTRA_ELF_DEPENDENCIES += $(wildcard core/*.h)
EXTRA_ELF_DEPENDENCIES += $(wildcard drivers/*.h)
EXTRA_ELF_DEPENDENCIES += funconfig.h

-include $(KEYBOARD_DIR)/rules.mk

include $(CH32FUN)/ch32fun.mk

all : flash

# ch32fun.mk compiles $(TARGET).c as the entry point, and TARGET has to live in
# build/ for the artefacts to land there - so build/main.c is generated as a
# one line shim onto the real entry point in core/. Depending on $(MAIN_C)
# keeps edits to it triggering a rebuild.
$(TARGET).c : $(MAIN_C) | $(BUILD_DIR)/config.sig
	$(PYTHON) -c "import sys; open(sys.argv[1],'w').write('/* Generated by firmware/Makefile - do not edit. */\n#include \"../firmware/$(MAIN_C)\"\n')" $(TARGET).c

# The real artefact is $(BUILD_DIR)/main.bin; `main.bin` stays as the public
# target name so the documented command line keeps working.
main.bin : $(TARGET).bin

# Records which keyboard/keymap build/ currently holds. Rewritten only when
# that changes, so it relinks on a switch and stays quiet otherwise. It also
# creates build/, which is why everything else orders itself after it.
$(BUILD_DIR)/config.sig : force
	@$(PYTHON) ../tools/stamp.py $(BUILD_DIR)/config.sig $(KEYBOARD) $(KEYMAP)

$(LINKER_SCRIPT) : $(CH32FUN)/ch32fun.ld | $(BUILD_DIR)/config.sig
	$(PREFIX)-gcc -E -P -x c -DTARGET_MCU=$(TARGET_MCU) -DMCU_PACKAGE=$(MCU_PACKAGE) -DTARGET_MCU_LD=$(TARGET_MCU_LD) -DTARGET_MCU_MEMORY_SPLIT=$(TARGET_MCU_MEMORY_SPLIT) $(CH32FUN)/ch32fun.ld > $(LINKER_SCRIPT)

# ch32fun.mk owns the main.bin rule, so the overflow check hangs off a stamp
# file that main.bin depends on. No build can then quietly hand back an image
# whose .text has grown into the keymap store.
#
# Order-only (the `|`) matters: ch32fun.mk's recipe passes $^ to objdump, and a
# normal prerequisite would end up on that command line.
$(TARGET).bin : | $(TARGET).guard

$(TARGET).guard : $(TARGET).elf
	$(PYTHON) ../tools/flash_guard.py --prefix $(PREFIX) --elf $(TARGET).elf
	@echo ok > $(TARGET).guard

flash : cv_flash

# Not cv_clean: that uses Windows `del` with forward-slash paths. Dropping the
# whole build directory is both simpler and portable.
clean :
	$(PYTHON) -c "import shutil,sys; shutil.rmtree(sys.argv[1], ignore_errors=True)" $(BUILD_DIR)
	-$(PYTHON) -c "import os; os.path.exists('nul') and os.remove('nul')"

.PHONY : all flash clean main.bin force
